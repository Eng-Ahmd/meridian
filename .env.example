# Copy to .env and adjust. Every value has a safe default; the app runs without this file.
MERIDIAN_ENVIRONMENT=development
MERIDIAN_LOG_LEVEL=INFO

# sqlite:///./data/meridian.db is the default. For Postgres:
# MERIDIAN_DATABASE_URL=postgresql+psycopg2://meridian:${MERIDIAN_DB_PASSWORD}@db:5432/meridian
MERIDIAN_DATABASE_URL=

# Required by docker-compose.yml for the Postgres password. Never commit a real
# value here; export it in your shell or a local (gitignored) .env file.
MERIDIAN_DB_PASSWORD=

# LLM is optional. "none" (default) uses deterministic template summaries.
# "openai-compatible" calls {base_url}/chat/completions for narrative summaries only.
MERIDIAN_LLM_PROVIDER=none
MERIDIAN_LLM_BASE_URL=
MERIDIAN_LLM_API_KEY=
MERIDIAN_LLM_MODEL=

# Policy guardrails (see docs/configuration.md)
MERIDIAN_MAX_SINGLE_PO_VALUE=25000
MERIDIAN_APPROVAL_THRESHOLD=5000
MERIDIAN_DEFAULT_SERVICE_LEVEL=0.95
MERIDIAN_FORECAST_HORIZON_DAYS=30
MERIDIAN_REVIEW_PERIOD_DAYS=7
